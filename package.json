{
  "name": "habit-grid",
  "productName": "Habit Grid",
  "version": "1.0.4",
  "description": "Habit tracking grid in the system tray",
  "main": "./out/main/index.js",
  "author": "Albert",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "test:db": "node scripts/test-db.mjs",
    "package:mac": "npm run build && electron-builder --mac --dir --arm64 --x64",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "release:win": "node scripts/release.mjs package:win",
    "release:mac": "node scripts/release.mjs install:mac",
    "install:mac": "bash scripts/install-mac.sh"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  }
}
